# Postgres connection string used by the app. Any Postgres works; the demo uses
# Supabase's transaction pooler (port 6543), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/clearpath

# Optional. Used by npm run db:push and db:seed from your machine. With Supabase, use
# the session pooler (same host as above, port 5432). Falls back to DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/clearpath
